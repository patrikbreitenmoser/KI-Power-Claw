# ===========================================
# KI Power Claw Configuration
# ===========================================
# Copy this to .env and fill in your values:
#   cp .env.example .env

# --- Required ---

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use this bot
# Send /chatid to the bot to get your ID, then add it here
ALLOWED_USER_IDS=

# --- Voice (Speech-to-Text) ---

# Groq API key for Whisper transcription (free at console.groq.com)
GROQ_API_KEY=

# --- Video Analysis ---

# Google API key for Gemini video analysis (free at aistudio.google.com)
GOOGLE_API_KEY=

# --- Logging ---

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
