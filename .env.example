# ===========================================
# KI Power Claw Configuration
# ===========================================
# Copy this to .env and fill in your values:
#   cp .env.example .env

# --- Required ---

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use this bot
# Send /chatid to the bot to get your ID, then add it here.
# If left empty, the first private user who messages the running bot is
# registered automatically and the bot locks to that user from then on.
ALLOWED_USER_IDS=

# --- Voice (Speech-to-Text) ---

# Groq API key for Whisper transcription (free at console.groq.com)
GROQ_API_KEY=

# --- Gemini Workflows (Video + Image Skills) ---

# Gemini API key used for:
# - Telegram video analysis via Gemini
# - Gemini image skills/workflows (e.g. nanobana)
# Set ONE alias only. If this is set, leave GOOGLE_API_KEY empty.
GEMINI_API_KEY=

# Alternative alias for the same Gemini API key (free at aistudio.google.com).
# Set this only if GEMINI_API_KEY is empty.
GOOGLE_API_KEY=

# --- Logging ---

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Agent trace logging to JSONL files under store/agent-trace
# off: disable trace files
# errors: log only failed agent runs (with full prompt/result)
# full: log all agent runs (with full prompt/result)
AGENT_TRACE_MODE=off

# Keep trace files for N days (1..365)
AGENT_TRACE_RETENTION_DAYS=14

# Optional custom directory for trace files
# AGENT_TRACE_DIR=/absolute/path/to/traces
