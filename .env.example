# ===========================================
# ClaudeClaw Configuration
# ===========================================
# Copy this to .env and fill in your values:
#   cp .env.example .env

# --- Required ---

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (send /chatid to your bot to get this)
ALLOWED_CHAT_ID=

# --- Voice (Speech-to-Text) ---

# Groq API key for Whisper transcription (free at console.groq.com)
GROQ_API_KEY=

# --- Video Analysis ---

# Google API key for Gemini video analysis (free at aistudio.google.com)
GOOGLE_API_KEY=

# --- Logging ---

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
